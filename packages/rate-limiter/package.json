{
  "name": "@iol/rate-limiter",
  "version": "0.1.0",
  "description": "Distributed rate limiter (token bucket + sliding window) backed by Redis, with a Fastify adapter",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fastify": {
      "source": "./src/fastify/index.ts",
      "types": "./dist/fastify/index.d.ts",
      "default": "./dist/fastify/index.js"
    }
  },
  "imports": {
    "#core/*": {
      "source": "./src/core/*",
      "default": "./dist/core/*"
    },
    "#strategies/*": {
      "source": "./src/strategies/*",
      "default": "./dist/strategies/*"
    },
    "#stores/*": {
      "source": "./src/stores/*",
      "default": "./dist/stores/*"
    },
    "#fastify/*": {
      "source": "./src/fastify/*",
      "default": "./dist/fastify/*"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/stores/lua', 'dist/stores/lua', { recursive: true })\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "fastify-plugin": "^6.0.1",
    "ioredis": "^6.0.0"
  },
  "peerDependencies": {
    "fastify": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testcontainers/redis": "^12.2.1",
    "fastify": "^5.12.8",
    "testcontainers": "^12.2.1"
  }
}
