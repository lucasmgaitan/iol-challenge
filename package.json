{
  "name": "@iol/api",
  "version": "0.1.0",
  "description": "HTTP service protected by @iol/rate-limiter",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "imports": {
    "#controllers/*": {
      "source": "./src/controllers/*",
      "default": "./dist/controllers/*"
    },
    "#http/*": {
      "source": "./src/http/*",
      "default": "./dist/http/*"
    }
  },
  "scripts": {
    "dev": "tsx --conditions=source watch src/server.ts",
    "build": "npm run build --workspaces && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "npm run typecheck --workspaces && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm test --workspaces && vitest run test/unit",
    "test:integration": "npm run test:integration --workspaces && vitest run test/integration",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@iol/rate-limiter": "*",
    "cockatiel": "^4.0.0",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
